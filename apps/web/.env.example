# --- HEXALYTE ERP (server-side only; never prefix with NEXT_PUBLIC_) ---
HX_API_BASE=https://<erp-api-host>/api/v1/store-api
HX_STORE_CREDENTIAL=hxs_<keyId>.<secret>

# --- Site ---
SITE_URL=http://localhost:3000

# --- Koko Buy Now Pay Later (server-side only; never prefix with NEXT_PUBLIC_; see docs/koko.md) ---
# QA: https://qaapi.paykoko.com   PROD: https://prodapi.paykoko.com
KOKO_BASE_URL=
KOKO_MERCHANT_ID=
KOKO_API_KEY=
KOKO_PLUGIN_NAME=
KOKO_PLUGIN_VERSION=
# Our private key (signs requests) and Koko's public key (verifies callbacks). PEM with \n escapes or real newlines.
KOKO_MERCHANT_PRIVATE_KEY=
KOKO_PUBLIC_KEY=
# Public https base URL Koko can reach for the webhook (ngrok/cloudflared in dev). Falls back to SITE_URL.
APP_URL=
# QA only: offer Koko even when the ERP has ONLINE payments switched off (a paid order is then refused by the ERP).
# KOKO_ALLOW_WITHOUT_ERP_ONLINE=false
# Comma-separated hostnames allowed for product images served by the ERP/CDN
ERP_IMAGE_HOSTS=
# Optional business details shown in header/footer/contact. Leave blank to hide.
# Phone numbers are hidden site-wide while SHOW_PHONE is false in src/lib/brand.ts
SITE_CONTACT_PHONE=
SITE_CONTACT_EMAIL=
SITE_CONTACT_ADDRESS=
# Opening hours shown in the footer, lines separated by | (blank = hidden)
SITE_BUSINESS_HOURS=
# Payment brands under "We accept" in the footer (comma list: visa,mastercard,amex,frimi,ezcash,mcash,koko,genie). List ONLY methods checkout really offers.
SITE_PAYMENT_METHODS=
SITE_ANNOUNCEMENT=

# --- Homepage (optional) ---
# HOME_BANNERS=[{"variant":"dark","headline":"The latest smartphones","ctaLabel":"Shop phones","href":"/categories/mobile-phones","categorySlug":"mobile-phones"}]
SITE_SOCIAL_FACEBOOK=
SITE_SOCIAL_INSTAGRAM=

# --- Header / service bar text (owner-supplied claims; leave blank to show only facts from ERP settings) ---
# SITE_ANNOUNCEMENT=Sri Lanka's Trusted Electronics Store
# SITE_HIGHLIGHTS=Islandwide Delivery|Secure Payments
# SITE_SERVICE_BAR=Islandwide Delivery:Fast & Reliable Service|Secure Payments:100% Safe Checkout|Payment Options:Cash on Delivery|Customer Support:Here to Help You
SITE_CONTACT_WHATSAPP=

# --- Customer accounts (website-only PostgreSQL; never the ERP or a production DB in development) ---
# Leave blank to run without accounts (guest checkout still works).
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/valta_web

# Staff emails allowed into /admin/orders (comma-separated), and the secret for the order-sync scheduler endpoint (16+ chars)
ADMIN_EMAILS=
ORDER_SYNC_SECRET=

# 32+ random characters. Lets the admin save the ERP credential encrypted in the database (Admin > ERP Settings).
SETTINGS_ENCRYPTION_KEY=

# Local demo of the AI assistant's cards (mock data only, no Agent connection). Leave unset or false everywhere except a developer machine.
ASSISTANT_DEMO_ENABLED=false

# Homepage customer reviews (real reviews only; the section stays hidden until set). JSON array, max 9.
# HOME_REVIEWS=[{"name":"Name","rating":5,"text":"What the customer said.","when":"2 months ago"}]
# REVIEWS_URL=https://g.page/r/your-google-review-link   # optional "Review us" button (https only)

# --- Payzy instalment payments (names only; real values go in .env.local, never in git) ---
# Every "$" in PAYZY_SECRET_KEY MUST be written as "\$" because Next.js expands $VAR in .env files and hosting settings.
# The key is 60 characters and starts with $2b$; the app refuses to use it otherwise.
PAYZY_BASE_URL=
PAYZY_SHOP_ID=
PAYZY_SECRET_KEY=
PAYZY_TEST_MODE=
# Only if the sandbox rejects the request signature: sign "x_version1.0" like Payzy's sample (see docs/payzy.md).
# PAYZY_LEGACY_VERSION_SIGNING=on
# QA only: offer Payzy even when the ERP has online payment switched off.
# PAYZY_ALLOW_WITHOUT_ERP_ONLINE=true

# --- AI shopping assistant (server-side only; never prefix with NEXT_PUBLIC_). Leave blank to keep it off. ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
