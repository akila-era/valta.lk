# --- HEXALYTE ERP (server-side only; never prefix with NEXT_PUBLIC_) ---
HX_API_BASE=https://<erp-api-host>/api/v1/store-api
HX_STORE_CREDENTIAL=hxs_<keyId>.<secret>

# --- Site ---
SITE_URL=http://localhost:3000
# Comma-separated hostnames allowed for product images served by the ERP/CDN
ERP_IMAGE_HOSTS=
# Optional business details shown in header/footer/contact. Leave blank to hide.
SITE_CONTACT_PHONE=
SITE_CONTACT_EMAIL=
SITE_CONTACT_ADDRESS=
# Opening hours shown in the footer, lines separated by | (blank = hidden)
SITE_BUSINESS_HOURS=
# Payment brands under "We accept" in the footer (comma list: visa,mastercard,amex,frimi,ezcash,mcash,koko,genie). List ONLY methods checkout really offers.
SITE_PAYMENT_METHODS=
SITE_INSTALMENTS=
SITE_ANNOUNCEMENT=

# --- Homepage (optional) ---
# HOME_BANNERS=[{"variant":"dark","headline":"The latest smartphones","ctaLabel":"Shop phones","href":"/categories/mobile-phones","categorySlug":"mobile-phones"}]
SITE_SOCIAL_FACEBOOK=
SITE_SOCIAL_INSTAGRAM=

# --- Header / service bar text (owner-supplied claims; leave blank to show only facts from ERP settings) ---
# SITE_ANNOUNCEMENT=Sri Lanka's Trusted Electronics Store
# SITE_HIGHLIGHTS=Islandwide Delivery|Secure Payments
# SITE_SERVICE_BAR=Islandwide Delivery:Fast & Reliable Service|Secure Payments:100% Safe Checkout|Payment Options:Cash on Delivery|Customer Support:Here to Help You
SITE_CONTACT_WHATSAPP=

# --- Customer accounts (website-only PostgreSQL; never the ERP or a production DB in development) ---
# Leave blank to run without accounts (guest checkout still works).
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/volta_web

# Staff emails allowed into /admin/orders (comma-separated), and the secret for the order-sync scheduler endpoint (16+ chars)
ADMIN_EMAILS=
ORDER_SYNC_SECRET=

# 32+ random characters. Lets the admin save the ERP credential encrypted in the database (Admin > ERP Settings).
SETTINGS_ENCRYPTION_KEY=

# --- AI shopping assistant (off by default; see docs/AI_ASSISTANT_WEB_INTEGRATION.md) ---
# Turn on only when the Agent is reachable and these are all set. The Agent is private: this server is the only caller.
AI_ASSISTANT_ENABLED=false
# Loopback http (for example an SSH tunnel's local port) or https. Plain http to any other host is refused.
# AI_AGENT_URL=http://127.0.0.1:18787
# AI_AGENT_HMAC_KEY_ID=web1
# 32+ random characters, the same value as in the Agent's AGENT_HMAC_KEYS (keyId:secret). Never commit it.
# AI_AGENT_HMAC_SECRET=
# AI_AGENT_TIMEOUT_MS=50000
# Private preview: 16+ characters. While set, only a browser that opened /api/assistant/preview?key=<this key> sees the assistant
# (everyone else gets nothing, as if it were off). Leave unset to open it to all visitors.
# AI_ASSISTANT_PREVIEW_KEY=
# While the Agent runs on MOCK data, cards are labelled "Demo data". Set to false only when it serves real catalogue data.
AI_ASSISTANT_DEMO_DATA=true
# Voice in the assistant modal (microphone input and spoken replies). Leave EMPTY until the routes /api/assistant/voice/transcribe
# and /api/assistant/voice/speak exist and have passed end-to-end tests; with it empty the modal says voice is not available yet.
# The site's Permissions-Policy header is fixed at BUILD time: with "stt" it allows the microphone for this site's own pages only,
# otherwise it stays blocked. So set this at build time too (Docker build argument), not only at run time.
# AI_ASSISTANT_VOICE=stt,tts
