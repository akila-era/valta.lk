# VOLTA.LK AI Agent API: variable NAMES only. Never commit real values. Nothing here is deployed.
# Secrets come from the host's root-owned env file, never from the repository.

# Required. "keyId:secret" pairs separated by commas (two keys allow rotation). Each secret needs 32+ random characters.
AGENT_HMAC_KEYS=

# Must stay loopback in M1. Anything else is refused unless AGENT_ALLOW_NON_LOOPBACK=true (not approved for any environment yet).
AGENT_HOST=127.0.0.1
AGENT_PORT=8787
# AGENT_ALLOW_NON_LOOPBACK=

# Must be a loopback address. Ollama is never exposed or reached over the network.
OLLAMA_URL=http://127.0.0.1:11434

# Kill switch. Defaults to false: the assistant is off until explicitly enabled.
AI_ASSISTANT_ENABLED=false
# CAPTCHA-ready hook, no provider chosen. "off" (default) or "on-abuse" (a client that hit a limit must present a challenge token;
# with no provider wired in, such a client is refused until the challenge window passes).
AI_CHALLENGE_MODE=off

# Limits (defaults shown)
AGENT_MAX_BODY_BYTES=20000
AGENT_MAX_MESSAGE_CHARS=800
AGENT_QUEUE_MAX_DEPTH=6
AGENT_DEADLINE_MS=45000
AGENT_HEARTBEAT_MS=15000
AGENT_MAX_IN_FLIGHT=16
# Abuse limits (defaults shown). Keys use only the signed client IP, signed identity and validated session id, never forwarded headers.
AGENT_RATE_IP_PER_MIN=40
AGENT_RATE_SESSION_PER_MIN=15
AGENT_RATE_IDENTITY_PER_MIN=30
AGENT_MAX_CONCURRENT_PER_IDENTITY=2
AGENT_NEW_SESSIONS_PER_HOUR=10
AGENT_AUTH_FAIL_PER_MIN=20
AGENT_COOLDOWN_AFTER=3
AGENT_COOLDOWN_SEC=60
# Natural replies for small talk and general questions, written by Qwen and checked by the verifier (no numbers, prices, stock,
# product names or links); anything unsafe falls back to the fixed text. Adds about 10 to 20 seconds to those replies on this CPU.
AGENT_CHAT_REPLIES=false
# English handling: router-first (default) or qwen (Qwen chooses tools; kept for evaluation).
AGENT_ENGLISH_MODE=router-first

# There is deliberately NO variable to log, retain or collect customer messages or consent in M1.
# Setting any AGENT_*/AI_* variable that mentions retain, log-message, consent or train makes startup fail.

# ---------------------------------------------------------------------------------------------------------------------------
# Gemini gateway (src/gateway). NOTHING in the Agent uses it yet. Placeholders only: never put a real key in this file or in Git.
# In production the key comes from the host's root-owned environment file or a secret manager, never from the repository, a browser,
# a database, a log or documentation. If a key is ever pasted anywhere else, revoke it and create a new one.
# Gemini stays OFF unless GEMINI_ENABLED is exactly "true".
# ---------------------------------------------------------------------------------------------------------------------------
GEMINI_ENABLED=false
GEMINI_API_KEY=
# Model identifiers are configuration, never code: names and prices change on a schedule (check Google's model and deprecation pages).
GEMINI_MODEL=
GEMINI_FAST_MODEL=
GEMINI_VOICE_MODEL=
# Optional. Must be https and a googleapis.com host unless GEMINI_ALLOW_CUSTOM_API_HOST=true. Empty uses the default Google host.
GEMINI_API_BASE_URL=
# Per-request caps. Empty uses the defaults (input 12000, output 800, thinking 0).
GEMINI_MAX_INPUT_TOKENS=
GEMINI_MAX_OUTPUT_TOKENS=
GEMINI_MAX_THINKING_TOKENS=
# The shipped price table is NOT verified by a person: paid calls are refused until it is replaced from a reviewed file
# (GATEWAY_PRICE_TABLE_PATH) or this is set to true. Leave empty/false.
# GEMINI_ALLOW_UNVERIFIED_PRICES=
# Budget in LKR (defaults 3000 / soft 2400 / hard 2700 / reserve 300). The exchange rate default is UNOFFICIAL: confirm it.
# GATEWAY_BUDGET_MONTHLY_LKR=
# GATEWAY_BUDGET_SOFT_LKR=
# GATEWAY_BUDGET_HARD_LKR=
# GATEWAY_BUDGET_RESERVE_LKR=
# GATEWAY_LKR_PER_USD=
# Where the spend ledger is kept so that a restart never resets spend (a file path on a persistent volume).
# GATEWAY_BUDGET_STORE_PATH=

# ---------------------------------------------------------------------------------------------------------------------------
# LLM-first lane (src/llm). EVERYTHING DEFAULTS TO OFF: with nothing set the existing pipeline answers exactly as before.
#   AGENT_LLM_FIRST          off | shadow | on   (shadow: the existing pipeline answers, the new lane only COUNTS in memory; needs Gemini ready
#                            AND the owner's privacy approval, because it sends the customer's text to the provider; on: refuses to serve until
#                            contract 1.4 has a source for model text)
#   AGENT_LLM_HISTORY        off | memory        (memory: the last few turns of ONE conversation are kept in RAM only and sent to the model)
#   AGENT_LLM_HISTORY_TURNS  1..10               (default 6)
#   AGENT_LLM_SHADOW_SAMPLE  0..1                (default 1)
# ---------------------------------------------------------------------------------------------------------------------------
# AGENT_LLM_FIRST=
# AGENT_LLM_HISTORY=
# AGENT_LLM_HISTORY_TURNS=
# AGENT_LLM_SHADOW_SAMPLE=
