# VOLTA.LK AI Agent API: variable NAMES only. Never commit real values. Nothing here is deployed.
# Secrets come from the host's root-owned env file, never from the repository.

# Required. "keyId:secret" pairs separated by commas (two keys allow rotation). Each secret needs 32+ random characters.
AGENT_HMAC_KEYS=

# Must stay loopback in M1. Anything else is refused unless AGENT_ALLOW_NON_LOOPBACK=true (not approved for any environment yet).
AGENT_HOST=127.0.0.1
AGENT_PORT=8787
# AGENT_ALLOW_NON_LOOPBACK=

# Must be a loopback address. Ollama is never exposed or reached over the network.
OLLAMA_URL=http://127.0.0.1:11434

# Kill switch. Defaults to false: the assistant is off until explicitly enabled.
AI_ASSISTANT_ENABLED=false
# CAPTCHA-ready hook, no provider chosen. "off" (default) or "on-abuse" (a client that hit a limit must present a challenge token;
# with no provider wired in, such a client is refused until the challenge window passes).
AI_CHALLENGE_MODE=off

# Limits (defaults shown)
AGENT_MAX_BODY_BYTES=20000
AGENT_MAX_MESSAGE_CHARS=800
AGENT_QUEUE_MAX_DEPTH=6
AGENT_DEADLINE_MS=45000
AGENT_HEARTBEAT_MS=15000
AGENT_MAX_IN_FLIGHT=16
# Abuse limits (defaults shown). Keys use only the signed client IP, signed identity and validated session id, never forwarded headers.
AGENT_RATE_IP_PER_MIN=40
AGENT_RATE_SESSION_PER_MIN=15
AGENT_RATE_IDENTITY_PER_MIN=30
AGENT_MAX_CONCURRENT_PER_IDENTITY=2
AGENT_NEW_SESSIONS_PER_HOUR=10
AGENT_AUTH_FAIL_PER_MIN=20
AGENT_COOLDOWN_AFTER=3
AGENT_COOLDOWN_SEC=60
# Natural replies for small talk and general questions, written by Qwen and checked by the verifier (no numbers, prices, stock,
# product names or links); anything unsafe falls back to the fixed text. Adds about 10 to 20 seconds to those replies on this CPU.
AGENT_CHAT_REPLIES=false
# English handling: router-first (default) or qwen (Qwen chooses tools; kept for evaluation).
AGENT_ENGLISH_MODE=router-first

# There is deliberately NO variable to log, retain or collect customer messages or consent in M1.
# Setting any AGENT_*/AI_* variable that mentions retain, log-message, consent or train makes startup fail.
